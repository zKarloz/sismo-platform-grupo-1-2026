# Configuración para desarrollo local únicamente: crea .env y cambia la contraseña.
POSTGRES_DB=sismo_db
POSTGRES_USER=sismo
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA_LOCAL
DATABASE_URL=postgresql+psycopg://sismo:CAMBIAR_CONTRASENA_LOCAL@127.0.0.1:5433/sismo_db
APP_NAME=Sistema de Monitoreo Sísmico V2
ENVIRONMENT=development
# Usadas solo en FastAPI para validar JWT; key pública, no secret/service_role.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EJEMPLO

# Alta administrativa de cuentas (SOLO FastAPI/Render, nunca VITE_*).
# SUPABASE_SECRET_KEY=sb_secret_TU_CLAVE_REAL
# URL pública verificada de Vercel, usada en invitaciones.
FRONTEND_PUBLIC_URL=https://tu-app.vercel.app
# Habilitar únicamente en desarrollo para cuentas .test ficticias.
ALLOW_DEMO_USER_CREATION=false
